<% layout("layouts/boilerplate") %>
<body>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter {
            text-align: center;
            margin-right: 1.8rem;
            margin-top: 2rem;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .filter a {
            color: black;
            text-decoration: none;
        }

        .remove-filter a {
            color: red;
            text-decoration: none;
        }

        .tax-info {
            display: none;
        }

        .tax-toggle {
            border: 1px solid black;
            border-radius: 1rem;
            height: 3rem;
            padding: 1rem;
            margin-left: 2rem;
            margin-top: 1rem;
            display: flex;
            align-items: center;
        }
    </style>

    <div id="filters">
        <div class="filter">
            <a href="/listings/filter?category=trending">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=rooms">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=iconic%20cities">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=mountains">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=castles">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=amazing%20pools">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=camping">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=farms">
                <div><i class="fa-solid fa-tractor"></i></div>
                <p>Farms</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=arctic">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=domes">
                <div><i class="fa-solid fa-mosque"></i></div>
                <p>Domes</p>
            </a>
        </div>

        <div class="filter">
            <a href="/listings/filter?category=boats">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Boats</p>
            </a>
        </div>

        <div class="filter remove-filter">
            <a href="/listings">
                <div><i class="fa-solid fa-filter-circle-xmark"></i></div>
                <p>Remove Filter</p>
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input
                    class="form-check-input"
                    type="checkbox"
                    role="switch"
                    id="flexSwitchCheckDefault"
                >
                <label
                    class="form-check-label"
                    for="flexSwitchCheckDefault"
                >
                    Display total after taxes
                </label>
            </div>
        </div>
    </div>

    <!-- Filter Results Heading -->
    <div class="filter-results-header">
        <h3 class="filter-results-heading">
            <% if (filterListings.length > 0) { %>
                <% 
                    const categoryHeadings = {
                        "trending": "Trending stays",
                        "rooms": "Rooms for your stay",
                        "iconic cities": "Stays in iconic cities",
                        "mountains": "Mountain stays",
                        "castles": "Castle stays",
                        "amazing pools": "Stays with amazing pools",
                        "camping": "Camping stays",
                        "farms": "Farm stays",
                        "arctic": "Arctic stays",
                        "domes": "Dome stays",
                        "boats": "Boat stays"
                    };
                %>
                <%= categoryHeadings[category] || "Explore stays" %>
            <% } %>
        </h3>
        <p class="filter-results-subtitle">
            <% if (filterListings.length > 0) { %>
                Discover places to stay that match your interests.
            <% } %>
        </p>
    </div>

    <!-- Listing Cards -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% if (filterListings.length === 0) { %>
            <div class="col-12 w-100 d-flex flex-column justify-content-center align-items-center text-center"
                 style="padding-top: 3rem;">
                <h3 style="color: #fe424d;">No stays found!</h3>
                <p class="text-muted mt-2">
                    We couldn't find any stays in this category.
                    <br>
                    Try exploring another category.
                </p>
                <a href="/listings" class="btn btn-dark mt-2">
                    Explore All Stays
                </a>
            </div>

        <% } else{ %>
            <% for(listing of filterListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                            style="height: 20rem;"
                        >
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b>
                                <br>
                                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                                <i class="tax-info">
                                    &nbsp; &nbsp; + 18% GST
                                </i>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        <% } %>
    </div>

    <div class="mb-3"></div>

    <script>
        const taxSwitch = document.getElementById("flexSwitchCheckDefault");

        taxSwitch.addEventListener("change", () => {
            const taxInfo = document.getElementsByClassName("tax-info");

            for (const info of taxInfo) {
                info.style.display = taxSwitch.checked ? "inline" : "none";
            }
        });
    </script>

</body>
