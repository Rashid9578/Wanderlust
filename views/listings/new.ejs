<% layout("layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Airbnb your home</h3>

            <form method="POST" action="/listings" novalidate
                class="needs-validation" enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input
                        name="listing[title]"
                        id="title"
                        placeholder="Add a catchy title"
                        type="text"
                        class="form-control"
                        required
                    >
                    <div class="valid-feedback">Title looks good!</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        name="listing[description]"
                        id="description"
                        placeholder="Enter the description"
                        class="form-control"
                        required
                    ></textarea>
                    <div class="invalid-feedback">
                        Please enter a short description
                    </div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input
                        name="listing[image]"
                        id="image"
                        type="file"
                        class="form-control"
                        required
                    >
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input
                            name="listing[price]"
                            id="price"
                            placeholder="1500"
                            type="number"
                            min="1"
                            class="form-control"
                            required
                        >
                        <div class="invalid-feedback">
                            Price should be valid
                        </div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input
                            name="listing[country]"
                            id="country"
                            placeholder="India"
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="invalid-feedback">
                            Country name should be valid
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input
                        name="listing[location]"
                        id="location"
                        placeholder="New Delhi"
                        type="text"
                        class="form-control"
                        required
                    >
                    <div class="invalid-feedback">
                        Location should be valid
                    </div>
                </div>

                <!-- Categories -->
                <div class="mb-3">
                    <label class="form-label">Categories</label>
                    <p class="text-muted small">
                        Select all categories that apply to your listing.
                    </p>

                    <div class="row row-cols-2 row-cols-md-4 g-2">
                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="trending"
                                    id="trending"
                                >
                                <label class="form-check-label" for="trending">
                                    Trending
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="iconic cities"
                                    id="iconicCities"
                                >
                                <label class="form-check-label" for="iconicCities">
                                    Iconic Cities
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="rooms"
                                    id="rooms"
                                >
                                <label class="form-check-label" for="rooms">
                                    Rooms
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="mountains"
                                    id="mountains"
                                >
                                <label class="form-check-label" for="mountains">
                                    Mountains
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="castles"
                                    id="castles"
                                >
                                <label class="form-check-label" for="castles">
                                    Castles
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="amazing pools"
                                    id="amazingPools"
                                >
                                <label class="form-check-label" for="amazingPools">
                                    Amazing Pools
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="camping"
                                    id="camping"
                                >
                                <label class="form-check-label" for="camping">
                                    Camping
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="farms"
                                    id="farms"
                                >
                                <label class="form-check-label" for="farms">
                                    Farms
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="arctic"
                                    id="arctic"
                                >
                                <label class="form-check-label" for="arctic">
                                    Arctic
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="domes"
                                    id="domes"
                                >
                                <label class="form-check-label" for="domes">
                                    Domes
                                </label>
                            </div>
                        </div>

                        <div class="col">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="listing[category]"
                                    value="boats"
                                    id="boats"
                                >
                                <label class="form-check-label" for="boats">
                                    Boats
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-dark add-btn mb-3">
                    Add
                </button>
            </form>
        </div>
    </div>
</body>


